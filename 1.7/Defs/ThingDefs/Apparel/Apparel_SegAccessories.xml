	<!-- Cargo pack -->
	<ThingDef ParentName="Seg_AccessoryBase">
		<defName>Seg_Apparel_CargoPack</defName>
		<label>field pouches</label>
		<description>These pouches can be worn to enable the wearer to carry more equipment - especially useful on expeditions and for extended field operations. When worn with appropriate armour they will take the form of an integrated backpack, but provides its extra carrying capacity even if worn by itself.</description>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<texPath>Things/Apparel/CargoPack/Seg_CargoPack</texPath>
		</graphicData>
		<statBases>
		<MarketValue>150</MarketValue>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>ComplexClothing</researchPrerequisite>
		</recipeMaker>
		<costList>
			<Steel>20</Steel>
			<Cloth>20</Cloth>
		</costList>
		<equippedStatOffsets>
				<MoveSpeed>-0.10</MoveSpeed>
				<CarryingCapacity>35</CarryingCapacity>
				<VEF_MassCarryCapacity>35</VEF_MassCarryCapacity>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPaths>
				<li>Things/Apparel/CargoPack/Seg_CargoPack</li>
			</wornGraphicPaths>
			<tags>
				<li>Seg_Accessory_Pouches</li>
			</tags>
			<wornGraphicData>
				<north>
					<male>
						<offset>(0, -0.25)</offset>
					</male>
					<female>
						<offset>(0,-0.3)</offset>
