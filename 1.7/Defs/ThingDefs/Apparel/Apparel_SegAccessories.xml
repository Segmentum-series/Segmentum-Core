	<!-- Medicae bag -->
	<ThingDef ParentName="Seg_AccessoryBase">
		<defName>Seg_Apparel_MedicaeBag</defName>
		<label>medicae bag</label>
		<description>This medicae bag can be worn to enable the wearer to carry some extra equipment and first aid essentials when providing medical treatment. When worn with appropriate armour it will take the form of an integrated backpack, but provides its bonuses even if worn by itself.</description>
		<graphicData>
		<graphicClass>Graphic_Single</graphicClass>
		<shaderType>CutoutComplex</shaderType>
		<texPath>Things/Apparel/MedicaeBag/Seg_MedicaeBag</texPath>
		</graphicData>
		<statBases>
		<MarketValue>200</MarketValue>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>DrugProduction</researchPrerequisite>
		</recipeMaker>
		<costList>
		<Steel>20</Steel>
		<Cloth>30</Cloth>
		<MedicineIndustrial>2</MedicineIndustrial>
		</costList>
		<equippedStatOffsets>
				<MoveSpeed>-0.10</MoveSpeed>
				<CarryingCapacity>10</CarryingCapacity>
				<VEF_MassCarryCapacity>10</VEF_MassCarryCapacity>
				<MedicalTendQuality>0.10</MedicalTendQuality>
				 <MedicalSurgerySuccessChance>0.15</MedicalSurgerySuccessChance>
				<MedicalOperationSpeed>0.15</MedicalOperationSpeed>
		</equippedStatOffsets>
		<apparel>
			<tags>
				<li>Seg_Accessory_Medicae</li>
			</tags>
			<wornGraphicPaths>
				<li>Things/Apparel/MedicaeBag/Seg_MedicaeBag</li>
