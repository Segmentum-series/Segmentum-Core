	<!-- Power pack -->
	<ThingDef ParentName="Seg_AccessoryBase">
		<defName>Seg_Apparel_PowerPack</defName>
		<label>powerpack</label>
		<description>This powerpack can be worn to provide power to certain weapons that depend on a portable source of energy. When worn with appropriate armour it will take the form of an integrated backpack, but provides charge to weapons even if worn by itself. \n\n&lt;color=#bb8f04&gt;Contains a large dedicated power reserve, which can be refuelled with uranium&lt;/color&gt;.</description>
		<graphicData>
		<graphicClass>Graphic_Single</graphicClass>
		<shaderType>CutoutComplex</shaderType>
		<texPath>Things/Apparel/PowerPack/Seg_PowerPack</texPath>
		</graphicData>
		<statBases>
		<MarketValue>350</MarketValue>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>Batteries</researchPrerequisite>
		</recipeMaker>
		<costList>
		<Steel>30</Steel>
		<Uranium>5</Uranium>
		<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<equippedStatOffsets>
				<MoveSpeed>-0.15</MoveSpeed>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPaths>
				<li>Things/Apparel/PowerPack/Seg_PowerPack</li>
			</wornGraphicPaths>
			<tags>
				<li>Seg_Accessory_Powerpack</li>
			</tags>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>150</maxCharges>
				<ammoDef>Uranium</ammoDef>
				<ammoCountToRefill>16</ammoCountToRefill><!-- Refills the entire backpack's power source. Can be replaced with "<ammoCountPerCharge>0.0</ammoCountPerCharge>" -->
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>powercell</chargeNoun>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
				<displayGizmoWhileDrafted>true</displayGizmoWhileDrafted>
			</li>
			<li Class="seg.CompProperties_HideWithBackpack"/>
		</comps>
	</ThingDef>

